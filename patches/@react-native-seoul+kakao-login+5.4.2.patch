+    @ReactMethod
+    private fun loginWithNewScopes(scopes: ReadableArray, promise: Promise) {
+        val activity = reactContext.currentActivity
+        if (activity == null) {
+            promise.reject("RNKakaoLogins", "Activity is null")
+            return
+        }
+
+        val requestedScopes = scopes.toArrayList().map { it.toString() }
+        UserApiClient.instance.loginWithNewScopes(activity, requestedScopes) { token, error: Throwable? ->
+            if (error != null) {
+                promise.reject("RNKakaoLogins", error.message, error)
+                return@loginWithNewScopes
+            }
+
+            if (token != null) {
+                val (accessToken, accessTokenExpiresAt, refreshToken, refreshTokenExpiresAt, idToken, allowedScopes) = token
+                val map = Arguments.createMap()
+                map.putString("accessToken", accessToken)
+                map.putString("refreshToken", refreshToken)
+                map.putString("idToken", idToken)
+                map.putString("accessTokenExpiresAt", dateFormat(accessTokenExpiresAt))
+                map.putString("refreshTokenExpiresAt", dateFormat(refreshTokenExpiresAt))
+                val scopeArray = Arguments.createArray()
+                if (allowedScopes != null) {
+                    for (scope in allowedScopes) {
+                        scopeArray.pushString(scope)
+                    }
+                }
+                map.putArray("scopes", scopeArray)
+                promise.resolve(map)
+                return@loginWithNewScopes
+            }
+
+            promise.reject("RNKakaoLogins", "Token is null")
+        }
+    }
